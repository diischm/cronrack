# Settings for `docker compose up -d`. Copy to .env and fill in:
#
#   cp .env.example .env
#
# Never commit the real .env (it is gitignored). For running without Docker,
# see server/.env.example instead.

# The name you open CronRack with, and the name agents connect to.
# Just the name: no https://, no port, no path. Examples: cronrack.home.lan,
# homelab.tailnet-name.ts.net, localhost (testing on this machine).
CRONRACK_DOMAIN=cronrack.home.lan

# Required: the server refuses to start without it. Keep it secret and keep it the
# same (changing it logs everyone out). Generate one and write it into .env with:
#
#   sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_urlsafe(50))')|" .env
#
# (token_urlsafe only uses letters, digits, - and _, so docker compose reads it as-is.)
SECRET_KEY=

# 1 = the app sits behind Caddy (always the case with docker compose).
BEHIND_PROXY=1

# Never 1 on a server.
DEBUG=0

# Optional. Django's admin pages at /admin/. Default: off (on only with DEBUG=1).
# CronRack's own pages cover everything, so you normally don't need it. With 0, /admin/
# answers 404. Its login is rate-limited like the normal one when you turn it on.
# CRONRACK_ENABLE_ADMIN=0

# Optional. Default: UTC
# TIME_ZONE=Europe/Berlin

# Optional. Extra names the server answers to, and extra origins forms may be posted
# from, comma-separated. CRONRACK_DOMAIN is always included; you normally need neither.
# ALLOWED_HOSTS=cronrack.home.lan,192.168.1.20
# CSRF_TRUSTED_ORIGINS=https://192.168.1.20

# Optional. debug, info, warning, error or critical. Default: info
# LOG_LEVEL=info

# Optional. plain (easy to read in `docker compose logs`) or json (one JSON object per
# line, for log collectors). Default: plain
# LOG_FORMAT=plain
