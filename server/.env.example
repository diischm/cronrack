# Copy to server/.env and fill in. Never commit the real .env (it is gitignored).
# Load it into your shell with:  set -a; . server/.env; set +a

# Required when DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# 1 only on your own machine. Never 1 on the server.
DEBUG=0

# Comma-separated hostnames the server answers to.
# With DEBUG=1 and this left empty, it defaults to: localhost,127.0.0.1,[::1]
ALLOWED_HOSTS=cronrack.example.lan,localhost

# Optional. Default: server/data/db.sqlite3 (the Docker image sets /data/db.sqlite3).
# Must be an absolute path.
# SQLITE_PATH=/var/lib/cronrack/db.sqlite3

# Optional. Extra origins forms may be posted from, comma-separated, each with its
# scheme (https://<CRONRACK_DOMAIN> is always included).
# CSRF_TRUSTED_ORIGINS=https://cronrack.example.lan:8443

# Optional. debug, info, warning, error or critical. Default: info
# LOG_LEVEL=info

# Optional. plain or json (one JSON object per line). Default: plain
# LOG_FORMAT=plain

# Optional. Default: UTC
TIME_ZONE=UTC

# Optional. The one name the server is reached by (docker compose sets this from the
# root .env). Added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS as https://<name>.
# CRONRACK_DOMAIN=cronrack.example.lan

# Optional. 1 only when a reverse proxy (Caddy) sits in front and sets X-Forwarded-Proto.
# BEHIND_PROXY=0

# Only for the Docker image (docker-entrypoint.sh): the reverse proxy addresses uvicorn
# believes X-Forwarded-* headers from. IP addresses and/or networks, comma-separated.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Optional. Django's admin at /admin/. Default: on with DEBUG=1, off otherwise.
# CRONRACK_ENABLE_ADMIN=0
